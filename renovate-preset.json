{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for dnlopes repositories: monthly updates, one automerged non-major PR per ecosystem, one major PR",
  "extends": [
    "config:best-practices",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    ":automergeRequireAllStatusChecks",
    ":enableVulnerabilityAlertsWithLabel(vulnerability)",
    ":labels(renovate, dependencies)",
    ":rebaseStalePrs",
    ":timezone(UTC)",
    "schedule:monthly"
  ],
  "reviewersFromCodeOwners": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "lockFileMaintenance": {
    "extends": ["schedule:monthly"],
    "automerge": true
  },
  "packageRules": [
    {
      "groupName": "{{manager}} non-major dependencies",
      "groupSlug": "{{manager}}-non-major",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "groupName": "all major dependencies",
      "groupSlug": "all-major",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    }
  ]
}
